# flow-atelier environment variables
# Copy to .env and uncomment/override as needed. All have sensible defaults.

# Base directory for conduits/ and flows/. Default: ./.atelier
# ATELIER_ATELIER_DIR=.atelier

# Global directory for shared conduits (flows are always project-local).
# Default: ~/.atelier
# ATELIER_GLOBAL_ATELIER_DIR=~/.atelier

# Per-task default timeout in seconds. Default: 3600
# ATELIER_DEFAULT_TIMEOUT=3600

# Max tasks running in parallel within a conduit. Default: 3
# ATELIER_DEFAULT_MAX_CONCURRENCY=3

# Harness launch commands come from the ACP registry — run
# `atelier harness list` to see every agent and how it starts, and
# `atelier harness sync` to refresh that list. The variables below only
# exist to override it.

# Pin the argv for one of the five harnesses that predate the registry.
# JSON array. Empty (default) uses the registry's pinned command.
# ATELIER_CLAUDE_LAUNCH_CMD=["npx","-y","@agentclientprotocol/claude-agent-acp@0.62.0"]
# ATELIER_CODEX_LAUNCH_CMD=["npx","-y","@agentclientprotocol/codex-acp@1.1.7"]
# ATELIER_OPENCODE_LAUNCH_CMD=["opencode","acp"]
# ATELIER_COPILOT_LAUNCH_CMD=["npx","-y","@github/copilot@1.0.75","--acp"]
# ATELIER_CURSOR_LAUNCH_CMD=["cursor-agent","acp"]

# Add an ACP agent the registry doesn't list, as a JSON object of
# name -> argv. Each entry registers `harness:<name>` as a tool your
# conduits can use, driven by the same executor as every other harness.
# A name that collides with a registry agent overrides it. Names must be
# lowercase letters, digits and hyphens.
# ATELIER_HARNESSES={"mine":["/opt/my-agent","--acp"]}

# Token the harness looks for in interactive mode. Default: [ATELIER_DONE]
# ATELIER_DONE_MARKER=[ATELIER_DONE]

# Optional bearer token for the HTTP/WS API served by `atelier serve`.
# When set, REST requests need 'Authorization: Bearer <token>' and WS
# connections need '?token=<token>'. Empty (default) = no auth.
# ATELIER_API_TOKEN=

# Where `atelier serve` answers. `atelier run` prints each run's page as
# <url>/runs/<flow_id>. Default: http://127.0.0.1:8000
# ATELIER_SERVE_URL=http://127.0.0.1:8000
