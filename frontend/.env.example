VITE_USE_MOCK_API=false
# Optional override for the backend origin. Unset, the SPA talks to whatever
# origin served it (works with `atelier serve`); set this only for a dev server
# on a separate port.
# VITE_BACKEND_URL=http://localhost:8080
# Optional bearer token for a Vite dev server pointed at an authenticated backend.
# Builds ignore this setting. The bundled UI asks for the token on its first 401.
VITE_API_TOKEN=
